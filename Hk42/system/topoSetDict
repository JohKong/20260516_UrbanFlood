        action  new;            // 动作：创建新集合
        source  patchToFace;// 源类型：通过长方体区域选择面
        sourceInfo
        {
            name inlet; // 从哪个面片选取？答：inlet
            // 长方体范围定义：(xmin ymin zmin) (xmax ymax zmax)
            box (-0.002 0 0) (0.001 1 0.020);
        }
    }

    {
        name    inletA;
        type    faceSet;
        action  subset;

        source  boxToFace;
        sourceInfo
        {
            // !!! 关键：定义包围你想要的“小方块”的立方体区域 !!!
            // 格式： (minX minY minZ) (maxX maxY maxZ)
            box (-0.002 0 0) (0.001 1 0.020);
            // 请务必根据你的实际几何尺寸修改这个box的坐标！
            // 你可以用 paraFoam 打开 case，查看 inlet 的位置和范围来确定这个box。
        }
    }

