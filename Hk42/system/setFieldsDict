FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      setFieldsDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

defaultFieldValues
(
    volScalarFieldValue alpha.water 0
);

regions
(
    boxToCell
    {
       box (0 0 0) (2 1 0.025);      // 在 XY 平面范围 (0~200, 0~200)，高度 0~0.5 m
        fieldValues
        (
            volScalarFieldValue alpha.water 1   // 水
        );
    }
);

