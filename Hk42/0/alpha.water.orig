FoamFile
{
    format      ascii;
    class       volScalarField;
    object      alpha.water;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [];
internalField   uniform 0;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 1;
    }

    inletA
    {
        type            zeroGradient;
    }


    outlet
    {
        type            inletOutlet;
        inletValue      $internalField;
        value           $internalField;
    }

    wall
    {
        type            zeroGradient;
    }

    buildings
    {
        type            zeroGradient;
    }

    frontAndBack
    {
        type            symmetry;    // 或 zeroGradient，看 boundary 文件
    }

}
// ************************************************************************* //