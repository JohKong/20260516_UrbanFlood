FoamFile
{
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    inlet
    {
        type            flowRateInletVelocity;
        volumetricFlowRate constant 0.0016;
    }

    outletB
    {
       type            noSlip;
    }

    inletA
    {
        type            zeroGradient;
    }

    outlet
    {
        type            pressureInletOutletVelocity;
        value           $internalField;
    }

    wall
    {
        type            noSlip;
    }

    buildings
    {
        type            noSlip;
    }

    #includeEtc "caseDicts/setConstraintTypes"
}

